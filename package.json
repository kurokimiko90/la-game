{
  "name": "la-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "play": "NEXT_DIST_DIR=.next-play next build && NEXT_DIST_DIR=.next-play next start -p 3220",
    "lint": "eslint",
    "content:scenes": "node scripts/build-scenes.mjs",
    "content:audio": "node scripts/build-audio.mjs",
    "content:voice": "node scripts/build-voice.mjs",
    "content:sync-svg": "node scripts/sync-svg.mjs",
    "content:preview": "node scripts/preview-sheet.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "next build && playwright test",
    "typecheck": "tsc --noEmit",
    "content:layout": "node scripts/build-layout.mjs",
    "content:scene-preview": "node scripts/preview-scene.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pinyin-pro": "^3.29.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
